{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES6",
        "outDir": "dist",
        "declaration": true,
        "strict": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowJs": true,
        "jsx": "preserve",
        "removeComments": true,
        "preserveConstEnums": true
    },
    "files": [ "index.ts" ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
