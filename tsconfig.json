{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES6",
        "strict": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowJs": true,
        "jsx": "preserve",
        "removeComments": true,
        "preserveConstEnums": true,
        "sourceMap": true
    },
    "files": [ "index.ts" ]
}
